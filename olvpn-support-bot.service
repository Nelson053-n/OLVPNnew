[Unit]
Description=OLVPN Support Bot - Telegram Support Service
After=network.target

[Service]
Type=simple
User=olvpn
Group=olvpn
WorkingDirectory=/opt/olvpn/OneYearVpb
Environment="PATH=/opt/olvpn/venv/bin"
ExecStart=/opt/olvpn/venv/bin/python /opt/olvpn/OneYearVpb/support_bot.py
Restart=always
RestartSec=10

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=olvpn-support-bot

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
